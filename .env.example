# ===== Identitas panel (wajib diisi sesuai kebutuhan) =====
# Nama yang tampil di panel, contoh: Panel Saya
BRAND_NAME=
# Domain utama di Cloudflare, contoh: domainkamu.com (kosongkan kalau belum pakai DNS)
CF_ZONE_NAME=
# Prefix package Android untuk APK builder, contoh: com.namakamu.app
APK_PACKAGE_PREFIX=

# ===== Wajib =====
PANEL_PASSWORD=
SESSION_SECRET=

# ===== Cloudflare (Edit zone DNS untuk CF_ZONE_NAME) =====
CF_API_TOKEN=
CF_ZONE_ID=

# ===== Hosting situs (isi yang dipakai saja) =====
VERCEL_TOKEN=
VERCEL_TEAM_ID=
NETLIFY_TOKEN=

# ===== GitHub (token classic dengan izin repo dan workflow) =====
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# ===== AI (Groq) =====
GROQ_API_KEY=

# ===== Img to URL (Supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=

# ===== Lainnya =====
NODE_ENV=production
TUNNEL_TOKEN=
PORT=3000
